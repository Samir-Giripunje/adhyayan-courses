{
  "course": {
    "id": "system-design",
    "title": "System Design for Interviews",
    "archetype": "field",
    "unit_prefix": "sd",
    "first_unit": 0
  },
  "outcomes": [
    {
      "id": "o1",
      "text": "Estimate the capacity a stated workload needs",
      "observable": "Given DAU, actions per user and payload sizes, produce peak QPS, storage per year and bandwidth figures within 2× of a reference answer, showing the arithmetic"
    },
    {
      "id": "o2",
      "text": "Turn a vague prompt into a scoped design",
      "observable": "A written list of functional and non-functional requirements, a REST/RPC API sketch and a data model for a prompt, produced in under 10 minutes"
    },
    {
      "id": "o3",
      "text": "Choose and justify a data storage design",
      "observable": "For a workload, a named store type (SQL, key-value, document, wide-column), replication mode, shard key and consistency level, each with one stated trade-off"
    },
    {
      "id": "o4",
      "text": "Scale the request path with standard building blocks",
      "observable": "A high-level diagram placing load balancers, caches, CDN and queues, with a cache strategy and load-balancing choice justified against the stated reads/writes ratio"
    },
    {
      "id": "o5",
      "text": "Find failure modes and specify reliability mechanisms",
      "observable": "For a given design, a list of single points of failure with a fix for each (failover, retries with backoff, circuit breaker, idempotency key) and a computed availability figure in nines"
    },
    {
      "id": "o6",
      "text": "Run a full system design interview under time",
      "observable": "A complete 45-minute mock answer to a classic prompt (URL shortener, news feed, chat, ride hailing) covering requirements, estimates, API, data model, high-level design, deep dive and bottlenecks"
    }
  ],
  "exclusions": [
    {
      "text": "Object-oriented / low-level design (class diagrams, design patterns in code)",
      "why": "A separate interview round with different skills; it would double the course"
    },
    {
      "text": "Authentication and identity protocols in depth (OAuth 2.0 flows, OIDC, SAML, SSO)",
      "why": "Interviews rarely go beyond 'use a token at the gateway'; covered in one security overview topic only"
    },
    {
      "text": "The full cloud design patterns catalogue (valet key, strangler fig, deployment stamps, gatekeeper, etc.)",
      "why": "Mostly migration and operations patterns that rarely come up in design interviews"
    },
    {
      "text": "Storage hardware and file systems (RAID, block volumes, HDFS internals)",
      "why": "Below the abstraction level interviewers expect; object storage is covered as a building block"
    },
    {
      "text": "VMs, containers and orchestration (Kubernetes)",
      "why": "Deployment tooling, not a design decision in typical interview prompts"
    },
    {
      "text": "Machine-learning system design (recommendation and ranking pipelines)",
      "why": "A specialised interview track with its own body of knowledge"
    },
    {
      "text": "Vendor-specific configuration (Redis, Kafka, Nginx, AWS service settings)",
      "why": "Interviews test the concept and trade-off, not the configuration syntax"
    }
  ],
