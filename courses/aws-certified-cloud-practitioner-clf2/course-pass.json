{
  "course": {
    "id": "aws-certified-cloud-practitioner-clf2",
    "title": "AWS Certified Cloud Practitioner (CLF-C02)",
    "archetype": "syllabus",
    "unit_prefix": "clf",
    "first_unit": 1
  },
  "outcomes": [
    {
      "id": "o1",
      "text": "Explain cloud concepts and the AWS value proposition",
      "observable": "Given a business scenario, pick the cloud benefit, Well-Architected pillar, Cloud Adoption Framework perspective or migration strategy (the 7 Rs) that fits, and justify the choice in one sentence"
    },
    {
      "id": "o2",
      "text": "Choose AWS global infrastructure placement",
      "observable": "For a stated latency, availability or data-residency requirement, choose between Regions, Availability Zones, edge locations, Local Zones, Wavelength and Outposts and name the reason"
    },
    {
      "id": "o3",
      "text": "Apply the shared responsibility model and AWS security services",
      "observable": "Sort a list of security tasks into AWS versus customer responsibility for EC2, RDS and Lambda, and name the IAM feature or security service (GuardDuty, Shield, WAF, KMS, Inspector, Macie, CloudTrail, Config, Artifact) that answers a stated security or compliance need"
    },
    {
      "id": "o4",
      "text": "Identify the right AWS service for a requirement",
      "observable": "Given a one-paragraph requirement, name the matching service across compute, storage, networking, database, integration, analytics, AI/ML, migration and management categories, and rule out the closest distractor"
    },
    {
      "id": "o5",
      "text": "Compare pricing models and choose cost and support resources",
      "observable": "For a described workload, choose On-Demand, Reserved Instances, Savings Plans or Spot and estimate the relative saving; pick the right tool (Pricing Calculator, Budgets, Cost Explorer, Cost and Usage Report) and the cheapest Support plan that meets a stated response-time need"
    },
    {
      "id": "o6",
      "text": "Pass the CLF-C02 exam under exam conditions",
      "observable": "Score at least 80% on two timed, full-length 65-question mock exams (90 minutes each) with every domain at or above 70%"
    }
  ],
  "exclusions": [
    {
      "text": "Hands-on console labs and deploying real workloads",
      "why": "CLF-C02 tests recognition and selection of services, not operating them; labs would roughly double the time without raising the score"
    },
    {
      "text": "Associate-level architecture depth (subnet CIDR math, VPC routing design, database tuning)",
      "why": "These belong to Solutions Architect Associate; the Cloud Practitioner exam only asks what each component is for"
    },
    {
      "text": "Writing code, CloudFormation templates or CLI scripts",
      "why": "The exam asks which deployment method fits, never to write one"
    },
    {
      "text": "Services the CLF-C02 exam guide lists as out of scope",
      "why": "They are not examined and would dilute study time"
    },
    {
      "text": "Exam registration, booking and testing-centre logistics",
      "why": "Administrative steps covered on the AWS Certification site, not exam content"
    },
    {
      "text": "Other AWS certifications (AI Practitioner, Associate and Professional tracks)",
      "why": "Separate exams with their own syllabi"
    }
  ],
